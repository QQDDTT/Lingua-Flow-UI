              "base": "昨天晚上八点",
              "rt": "zuó tiān wǎn shang bā diǎn"
            },
            {
              "base": "在车厢里",
              "rt": "zài chē xiāng lǐ"
            },
            {
              "base": "读书。",
              "rt": "dú shū"
